# Proxy de produção/staging. `handle` preserva o prefixo /api (brief 11.3).
{$APP_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 6MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	log {
		output stdout
		format json
	}
	handle /api/* {
		reverse_proxy api:3001
	}
	handle {
		reverse_proxy web:3000
	}
}

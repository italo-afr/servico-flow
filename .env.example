# Copie para .env e ajuste. Nunca commite .env.
NODE_ENV=development
APP_ENV=local
PORT=3001
PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgres://servicoflow:servicoflow@localhost:5432/servicoflow_dev
# Banco exclusivo para testes de integração (é APAGADO a cada execução)
TEST_DATABASE_URL=postgres://servicoflow:servicoflow@localhost:5432/servicoflow_test
# Gere com: openssl rand -hex 32
SESSION_SECRET=<gere-um-segredo-com-pelo-menos-32-caracteres>
TOKEN_PAYLOAD_ENCRYPTION_KEY=<64-caracteres-hex>
# Mailpit local (docker compose); em staging/produção use o provedor escolhido
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="ServiçoFlow <nao-responda@servicoflow.local>"
# Em local/staging/demo, só estes destinatários (ou domínios @x) recebem e-mail
EMAIL_ALLOWED_RECIPIENTS=@example.com,@servicoflow.local
RELEASE_SHA=dev
DEMO_MODE=false
# Métricas Prometheus em portas INTERNAS (0 desliga). Não publicar no proxy.
METRICS_PORT=9464
WORKER_METRICS_PORT=9465
# Destino dos alertas do avaliador embutido no worker (opcional)
OPS_ALERT_EMAIL=ops@example.com
# Sugestão de triagem por regras: experimental, desligada por padrão (ADR-0010)
TRIAGE_SUGGESTIONS=false

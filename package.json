{
  "name": "servicoflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "build:packages": "pnpm -r --filter ./packages/** build",
    "dev": "pnpm build:packages && pnpm -r --parallel --filter ./apps/** dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test:unit": "pnpm build:packages && pnpm -r test:unit",
    "test:integration": "pnpm build:packages && pnpm --filter @servicoflow/api test:integration",
    "db:migrate": "pnpm --filter @servicoflow/api db:migrate",
    "db:seed": "pnpm --filter @servicoflow/api db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "@eslint/js": "10.0.1",
    "typescript": "5.9.3"
  }
}
